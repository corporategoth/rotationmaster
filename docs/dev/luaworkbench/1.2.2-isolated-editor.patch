--- /dev/null
+++ b/EmbeddedModules.lua
@@ -0,0 +1,7 @@
+local _, addon = ...
+-- Each module still initializes the ordinary workspace once. Hosts can create
+-- independent namespaces from the same factories; no copied editor source.
+addon.EmbeddedFactories = {}
+function addon:DefineEmbeddedModule(name, factory)
+ self.EmbeddedFactories[name] = factory
+end
--- /dev/null
+++ b/Embedding.lua
@@ -0,0 +1,49 @@
+local packageName, addon = ...
+local API={version=1}
+_G.LuaWorkbenchEmbedding=API
+local modules={'BufferedPaste','LuaEditor','Analysis','LuaConsole','UI','Search','Organization','Helpers','Navigation','DebugProbe','DebugCompiler','Debugger','DebugUI','APIHelp','Autocomplete','EditorActions','KnowledgeBase','Snippets','Inspector','Automation'}
+local function copy(value)
+ if type(value)~='table' then return value end
+ local result={};for key,child in pairs(value) do result[key]=copy(child) end;return result
+end
+function API:CreateEngine(options)
+ options=options or {}
+ local settings=addon.Workspace and addon.Workspace.db and addon.Workspace.db.options or {}
+ local W={current=options.id or 'embedded',currentName=options.name or 'Embedded editor'}
+ W.db={options=copy(settings),snippets={},drafts={},folders={},folderBySnippet={},clearOnRun={},autoRun={},helperModules={},textSnippets={},panelPositions={},split=.65}
+ local engine={embedded=true,L=addon.L,ShortcutText=addon.ShortcutText,Workspace=W,embeddingOptions=options}
+ function W:UpdateStatus() if options.status then options.status(engine.Query.Console.statusText,engine.Query.Console.statusFailed) end end
+ function W:NormalizeSource(source) return (source or ''):gsub('\r\n','\n') end
+ function W:StoreSource(source) return self:NormalizeSource(source) end
+ function W:Capture()
+  local C=engine.Query.Console;self.db.drafts[self.current]={name=self.currentName,source=C.source};self.dirty=self:IsSnippetDirty(self.current);self:UpdateStatus()
+ end
+ function W:IsSnippetDirty(id) local draft,saved=self.db.drafts[id],self.db.snippets[id];return draft and (not saved or draft.source~=saved.source) or false end
+ function W:HidePanels(except)
+  for _,entry in ipairs({'KnowledgeBase','Snippets','Navigation','Inspector'}) do local panel=engine[entry] and (engine[entry].panel or engine[entry].snapshot);if panel and panel~=except then panel:Hide() end end
+ end
+ function W:Select(id) if options.navigate then return options.navigate(id) end;return false end
+ function W:Show() if options.show then options.show() end end
+ function W:ShowHelp() if options.help then options.help() end end
+ function W:Layout() if engine.control then engine.control:Layout() end end
+ function W:RunShortcut(key)
+  if engine.DebugUI:Shortcut(key) then return true end
+  if engine.Navigation:Shortcut(key) then return true end
+  return false
+ end
+ for _,name in ipairs(modules) do
+  local factory=addon.EmbeddedFactories[name];if not factory then return nil,'missing-embedded-module:'..name end
+  factory(packageName,engine)
+ end
+ function engine:Release()
+  if self.released then return end;self.released=true
+  self.Debugger:Stop();self.DebugProbe:Stop()
+  self.Workspace:HidePanels()
+  if self.Autocomplete then self.Autocomplete:Hide() end
+  if self.Automation.probe then self.Automation.probe:UnregisterAllEvents() end
+  if self.APIHelp and self.APIHelp.events then
+   self.APIHelp.events:UnregisterAllEvents();self.APIHelp.events:SetScript('OnEvent',nil)
+  end
+ end
+ return engine
+end
