# Generated by tools/generate_artwork_catalog.py. Originals remain in Git.
# The package holds what the game loads, and the license and notice files.
package-as: RotationMaster
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
move-folders:
